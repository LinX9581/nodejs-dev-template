<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/bootstrap.min.css">
</head>
<body class="bg-light">
  <div class="container py-5">
    <h1 class="h4 mb-3"><%= title %></h1>
    <p class="text-muted">此頁面不呼叫任何後端 API。</p>

    <button id="runBtn" class="btn btn-primary mb-3">執行前端計算</button>
    <div>計算耗時: <code id="cost">-</code> ms</div>
    <div>結果: <code id="result">-</code></div>

    <div class="mt-4">
      <a class="btn btn-outline-secondary" href="/stress">回工具頁</a>
    </div>
  </div>

  <script>
    const runBtn = document.getElementById("runBtn");
    const cost = document.getElementById("cost");
    const result = document.getElementById("result");

    runBtn.addEventListener("click", () => {
      const started = performance.now();
      let sum = 0;
      for (let i = 0; i < 800000; i += 1) {
        sum += Math.sqrt(i);
      }
      cost.textContent = (performance.now() - started).toFixed(2);
      result.textContent = sum.toFixed(2);
    });
  </script>
</body>
</html>
