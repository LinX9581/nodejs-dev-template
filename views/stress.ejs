<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">
    <div class="container py-4 py-md-5">
        <div class="row justify-content-center">
            <div class="col-12 col-xl-9">
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <h1 class="h3 mb-3"><%= title %></h1>
                        <p class="mb-2">前端網址: <code><%= frontendBaseUrl || "未設定 (目前使用當前網域)" %></code></p>
                        <p class="mb-0">後端網址: <code><%= backendBaseUrl || "未設定 (目前走 local fallback)" %></code></p>
                    </div>
                </div>

                <div class="card shadow-sm mb-4">
                    <div class="card-header">壓測參數</div>
                    <div class="card-body">
                        <form id="stressForm" class="row g-3">
                            <div class="col-12 col-md-4">
                                <label class="form-label" for="fanout">Fanout 次數</label>
                                <input id="fanout" class="form-control" type="number" min="1" max="200" value="<%= defaults.fanout %>">
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label" for="waitMs">每次等待 ms</label>
                                <input id="waitMs" class="form-control" type="number" min="1" max="2000" value="<%= defaults.waitMs %>">
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label" for="payloadKb">Payload KB</label>
                                <input id="payloadKb" class="form-control" type="number" min="1" max="256" value="<%= defaults.payloadKb %>">
                            </div>
                            <div class="col-12">
                                <button id="submitBtn" class="btn btn-primary" type="submit">執行一次壓測請求</button>
                                <a class="btn btn-outline-secondary ms-2" href="/">回首頁</a>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="card shadow-sm mb-4">
                    <div class="card-header">即時觀測（每秒更新）</div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <div class="border rounded p-3 h-100">
                                    <h2 class="h6 mb-3">連線與佇列</h2>
                                    <div class="small">FN in-flight: <code id="mFanoutInFlight">-</code> <span class="text-muted">(FN 目前正在處理的 fanout 請求數)</span></div>
                                    <div class="small">Upstream in-flight: <code id="mUpstreamInFlight">-</code> <span class="text-muted">(FN 同時打到 BN 的請求數)</span></div>
                                    <div class="small">HTTPS active sockets: <code id="mHttpsActive">-</code> <span class="text-muted">(正在使用中的 FN->BN 連線數)</span></div>
                                    <div class="small">HTTPS idle sockets: <code id="mHttpsIdle">-</code> <span class="text-muted">(keep-alive 閒置可重用連線數)</span></div>
                                    <div class="small">HTTPS queued requests: <code id="mHttpsQueued">-</code> <span class="text-muted">(等待可用 socket 的請求數，持續 > 0 代表連線池壅塞)</span></div>
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="border rounded p-3 h-100">
                                    <h2 class="h6 mb-3">Node.js 指標</h2>
                                    <div class="small">Event loop p95(ms): <code id="mEventLoopP95">-</code> <span class="text-muted">(CPU/同步阻塞壓力，越低越穩)</span></div>
                                    <div class="small">Event loop max(ms): <code id="mEventLoopMax">-</code> <span class="text-muted">(觀測期間最大卡頓尖峰)</span></div>
                                    <div class="small">RSS(MB): <code id="mRss">-</code> <span class="text-muted">(行程總記憶體用量)</span></div>
                                    <div class="small">Heap used(MB): <code id="mHeapUsed">-</code> <span class="text-muted">(V8 heap 已使用量)</span></div>
                                    <div class="small">Upstream failures(total): <code id="mUpstreamFail">-</code> <span class="text-muted">(FN 呼叫 BN 失敗累積數)</span></div>
                                </div>
                            </div>
                        </div>
                        <div class="mt-3">
                            <div class="small text-muted">最近錯誤樣本</div>
                            <pre id="mErrors" class="bg-light border rounded p-2 mb-0" style="min-height: 80px; white-space: pre-wrap;">[]</pre>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm">
                    <div class="card-header">結果</div>
                    <div class="card-body">
                        <pre id="resultBox" class="bg-dark text-light rounded p-3 mb-0" style="min-height: 220px; white-space: pre-wrap;">尚未執行</pre>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const form = document.getElementById("stressForm");
        const resultBox = document.getElementById("resultBox");
        const submitBtn = document.getElementById("submitBtn");
        const metricTargets = {
            fanoutInFlight: document.getElementById("mFanoutInFlight"),
            upstreamInFlight: document.getElementById("mUpstreamInFlight"),
            httpsActive: document.getElementById("mHttpsActive"),
            httpsIdle: document.getElementById("mHttpsIdle"),
            httpsQueued: document.getElementById("mHttpsQueued"),
            eventLoopP95: document.getElementById("mEventLoopP95"),
            eventLoopMax: document.getElementById("mEventLoopMax"),
            rss: document.getElementById("mRss"),
            heapUsed: document.getElementById("mHeapUsed"),
            upstreamFail: document.getElementById("mUpstreamFail"),
            errors: document.getElementById("mErrors")
        };

        async function refreshMetrics() {
            try {
                const response = await fetch("/stress/api/metrics");
                if (!response.ok) {
                    return;
                }

                const data = await response.json();
                metricTargets.fanoutInFlight.textContent = data.counters.fanoutInFlight;
                metricTargets.upstreamInFlight.textContent = data.counters.upstreamInFlight;
                metricTargets.httpsActive.textContent = data.agent.https.activeSockets;
                metricTargets.httpsIdle.textContent = data.agent.https.idleSockets;
                metricTargets.httpsQueued.textContent = data.agent.https.queuedRequests;
                metricTargets.eventLoopP95.textContent = data.node.eventLoopDelayMs.p95;
                metricTargets.eventLoopMax.textContent = data.node.eventLoopDelayMs.max;
                metricTargets.rss.textContent = data.node.memoryMb.rss;
                metricTargets.heapUsed.textContent = data.node.memoryMb.heapUsed;
                metricTargets.upstreamFail.textContent = data.counters.totalUpstreamFailures;
                metricTargets.errors.textContent = JSON.stringify(data.recentErrors.slice(-5), null, 2);
            } catch {
                // ignore metric refresh error
            }
        }

        form.addEventListener("submit", async (event) => {
            event.preventDefault();

            const payload = {
                fanout: Number(document.getElementById("fanout").value),
                waitMs: Number(document.getElementById("waitMs").value),
                payloadKb: Number(document.getElementById("payloadKb").value)
            };

            submitBtn.disabled = true;
            submitBtn.textContent = "執行中...";
            resultBox.textContent = "請求送出中...";

            try {
                const response = await fetch("/stress/api/fanout", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload)
                });

                const data = await response.json();
                resultBox.textContent = JSON.stringify(data, null, 2);
            } catch (error) {
                resultBox.textContent = JSON.stringify({ status: "error", message: error.message }, null, 2);
            } finally {
                submitBtn.disabled = false;
                submitBtn.textContent = "執行一次壓測請求";
            }
        });

        refreshMetrics();
        setInterval(refreshMetrics, 1000);
    </script>
</body>
</html>
